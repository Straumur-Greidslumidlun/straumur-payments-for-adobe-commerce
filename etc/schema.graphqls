type StraumurEmbeddedSessionOutput {
    checkoutReference: String!
    sessionId: String!
    sessionToken: String!
    responseIdentifier: String
    responseDateTime: String
    expiresAt: String
}

input StraumurEmbeddedSessionInput {
    cartId: String!
    origin: String!
    threeDsReturnUrl: String!
    culture: String
    manualCapture: Boolean
    expiresAt: String
    sendItems: Boolean @doc(description: "Deprecated and ignored. The Straumur embedded checkout session does not accept line items; only the cart total is sent. Kept so existing clients that pass it keep working.")
}

type StraumurEmbeddedSessionStatus {
    checkoutReference: String!
    status: String
    payfacReference: String
    responseDateTime: String
    responseIdentifier: String
    rawPayload: String
}

extend type Mutation {
    createStraumurEmbeddedSession(
        input: StraumurEmbeddedSessionInput!
    ): StraumurEmbeddedSessionOutput
        @resolver(class: "Straumur\\Payment\\Model\\Resolver\\CreateEmbeddedSession")
}

extend type Query {
    straumurEmbeddedSessionStatus(
        sessionToken: String!
    ): StraumurEmbeddedSessionStatus
        @resolver(class: "Straumur\\Payment\\Model\\Resolver\\GetEmbeddedSessionStatus")
}
